meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/create
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "test@test.com",
    "password": "test",
    "currency": "CZK"
  }
}

script:post-response {
  // Registration no longer returns tokens directly.
  // Response: { pendingVerification: true, userId, message }
  // Check backend logs for the verification code, then run "Verify Registration".
  if (res.status === 200) {
    bru.setVar("pendingUserId", res.body.userId);
  }
}
